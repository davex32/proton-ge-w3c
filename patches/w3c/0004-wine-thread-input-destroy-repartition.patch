+/* Find a surviving queue that owns input state which should remain with the old input. */
+static struct msg_queue *get_input_state_owner_queue( struct thread_input *input, struct msg_queue *dying )
+{
+    const user_handle_t handles[] = { input->shared->active, input->shared->focus, input->shared->capture };
+    struct thread *owner;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(handles); i++)
+    {
+        struct msg_queue *queue;
+
+        if (!handles[i] || !(owner = get_window_thread( handles[i] ))) continue;
+        queue = owner->queue;
+        release_object( owner );
+        if (queue && queue != dying && queue->input == input) return queue;
+    }
+    return NULL;
+}
+
+/* Repartition surviving components after an attached queue disappears. */
+static void split_thread_input_after_queue_removal( struct thread_input *input, struct msg_queue *dying,
+                                                    struct list *neighbors )
+{
+    struct detach_queue *entry;
+    struct msg_queue *keeper = get_input_state_owner_queue( input, dying );
+    struct list keeper_component;
+
+    if (list_empty( neighbors )) return;
+    if (!keeper) keeper = LIST_ENTRY( list_head( neighbors ), struct detach_queue, entry )->queue;
+    if (!detach_graph_component( input, keeper, &keeper_component )) return;
+
+    LIST_FOR_EACH_ENTRY( entry, neighbors, struct detach_queue, entry )
+    {
+        struct thread_input *new_input;
+        struct list component;
+
+        if (entry->queue->input != input || detach_graph_contains( &keeper_component, entry->queue )) continue;
+        if (!detach_graph_component( input, entry->queue, &component )) break;
+        if (!(new_input = create_thread_input( input->desktop )))
+        {
+            detach_graph_free( &component );
+            break;
+        }
+        move_detach_component( input, &component, new_input );
+        release_object( new_input );
+        detach_graph_free( &component );
+    }
+
+    detach_graph_free( &keeper_component );
+}
