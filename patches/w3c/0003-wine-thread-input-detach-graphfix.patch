+struct detach_queue
+{
+    struct list entry;
+    struct msg_queue *queue;
+};
+
+static int detach_graph_contains( const struct list *list, const struct msg_queue *queue )
+{
+    const struct detach_queue *entry;
+
+    LIST_FOR_EACH_ENTRY( entry, list, const struct detach_queue, entry )
+        if (entry->queue == queue) return 1;
+    return 0;
+}
+
+static int detach_graph_add( struct list *list, struct msg_queue *queue )
+{
+    struct detach_queue *entry;
+
+    if (detach_graph_contains( list, queue )) return 1;
+    if (!(entry = mem_alloc( sizeof(*entry) ))) return 0;
+    entry->queue = queue;
+    list_add_tail( list, &entry->entry );
+    return 1;
+}
+
+static void detach_graph_free( struct list *list )
+{
+    struct detach_queue *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, list, struct detach_queue, entry )
+    {
+        list_remove( &entry->entry );
+        free( entry );
+    }
+}
+
+/* Build the connected component containing seed from the remaining attachment edges. */
+static int detach_graph_component( struct thread_input *input, struct msg_queue *seed, struct list *component )
+{
+    struct attachment *attach;
+    int changed;
+
+    list_init( component );
+    if (!detach_graph_add( component, seed )) return 0;
+
+    do
+    {
+        changed = 0;
+        LIST_FOR_EACH_ENTRY( attach, &input->attachments, struct attachment, entry )
+        {
+            int in_from = detach_graph_contains( component, attach->queue_from );
+            int in_to = detach_graph_contains( component, attach->queue_to );
+
+            if (in_from && !in_to)
+            {
+                if (!detach_graph_add( component, attach->queue_to )) goto failed;
+                changed = 1;
+            }
+            else if (in_to && !in_from)
+            {
+                if (!detach_graph_add( component, attach->queue_from )) goto failed;
+                changed = 1;
+            }
+        }
+    } while (changed);
+    return 1;
+
+failed:
+    detach_graph_free( component );
+    return 0;
+}
+
+/* Move one already-discovered connected component, including its internal edges. */
+static void move_detach_component( struct thread_input *old_input, struct list *component,
+                                   struct thread_input *new_input )
+{
+    struct attachment *attach, *next;
+    struct detach_queue *entry;
+
+    LIST_FOR_EACH_ENTRY_SAFE( attach, next, &old_input->attachments, struct attachment, entry )
+    {
+        if (!detach_graph_contains( component, attach->queue_from ) ||
+            !detach_graph_contains( component, attach->queue_to )) continue;
+        list_remove( &attach->entry );
+        list_add_tail( &new_input->attachments, &attach->entry );
+    }
+
+    LIST_FOR_EACH_ENTRY( entry, component, struct detach_queue, entry )
+        assign_thread_input( entry->queue, new_input );
+}
