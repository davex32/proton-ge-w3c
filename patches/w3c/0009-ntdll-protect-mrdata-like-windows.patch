+static RTL_SRWLOCK mrdata_lock = RTL_SRWLOCK_INIT;
+static LONG mrdata_unprotected = 1;  /* writable until process initialization completes */
+
+/*************************************************************************
+ *		ldr_protect_mrdata
+ *
+ * Reference-counted protection of ntdll's .mrdata section, like Windows
+ * LdrProtectMrdata: read-only once process initialization completes,
+ * writable while any writer holds an unprotect reference.
+ */
+void ldr_protect_mrdata( BOOL protect )
+{
+    static void *mrdata_base;
+    static SIZE_T mrdata_size;
+    ULONG new_prot = 0, old_prot;
+
+    RtlAcquireSRWLockExclusive( &mrdata_lock );
+    if (!mrdata_base)
+    {
+        MEMORY_BASIC_INFORMATION meminfo;
+        IMAGE_SECTION_HEADER *sec;
+        IMAGE_NT_HEADERS *nt;
+        unsigned int i;
+
+        NtQueryVirtualMemory( GetCurrentProcess(), LdrInitializeThunk, MemoryBasicInformation,
+                              &meminfo, sizeof(meminfo), NULL );
+        nt = RtlImageNtHeader( meminfo.AllocationBase );
+        sec = IMAGE_FIRST_SECTION( nt );
+        for (i = 0; i < nt->FileHeader.NumberOfSections; i++, sec++)
+        {
+            if (memcmp( sec->Name, ".mrdata", sizeof(".mrdata") )) continue;
+            mrdata_base = (char *)meminfo.AllocationBase + sec->VirtualAddress;
+            mrdata_size = sec->Misc.VirtualSize;
+            break;
+        }
+    }
+    if (protect)
+    {
+        if (mrdata_unprotected && !--mrdata_unprotected) new_prot = PAGE_READONLY;
+    }
+    else if (!mrdata_unprotected++) new_prot = PAGE_READWRITE;
+
+    if (new_prot && mrdata_base)
+    {
+        void *addr = mrdata_base;
+        SIZE_T size = mrdata_size;
+
+        NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, new_prot, &old_prot );
+    }
+    RtlReleaseSRWLockExclusive( &mrdata_lock );
+}
+
