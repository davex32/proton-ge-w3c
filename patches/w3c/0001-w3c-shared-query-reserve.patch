index 00000000000..ac8d8cd29e4
--- /dev/null
+++ b/dlls/ntdll/unix/w3c_query_reader.h
@@ -0,0 +1,174 @@
+/* Included by virtual.c after fill_basic_memory_info. LGPL-2.1-or-later.
+ * Process-local index, serialized independently of virtual_mutex.
+ * Caches an allocation index only, never cached query answers.
+ */
+#ifdef W3C_QUERY_SUPPORTED
+static pthread_mutex_t w3c_reader_mutex = PTHREAD_MUTEX_INITIALIZER;
+static const struct w3c_query_header *w3c_import;
+static struct w3c_query_view *w3c_index;
+static unsigned int w3c_index_count;
+static unsigned long long w3c_import_id, w3c_index_topology;
+static HANDLE w3c_import_process;
+static unsigned int w3c_server_check_count;
+static int w3c_compare_views( const void *a, const void *b )
+{
+    const struct w3c_query_view *x = a, *y = b;
+    return (x->base > y->base) - (x->base < y->base);
+}
+static BOOL w3c_read_stable( unsigned long long sequence )
+{
+    __atomic_thread_fence( __ATOMIC_SEQ_CST );
+    return sequence == __atomic_load_n( &w3c_import->sequence, __ATOMIC_ACQUIRE );
+}
+/* Same byte comparison as get_vprot_range_size, over the contiguous mirror. */
+static SIZE_T w3c_protection_end( const BYTE *protection, SIZE_T idx, SIZE_T last, BYTE vprot )
+{
+    const unsigned long long repeat = 0x0101010101010101ULL;
+    const unsigned long long mask = repeat * (BYTE)~VPROT_WRITEWATCH;
+    const unsigned long long expected = repeat * (vprot & (BYTE)~VPROT_WRITEWATCH);
+    unsigned long long word;
+    while (idx < last && (idx & 7))
+    {
+        if ((protection[idx] ^ vprot) & (BYTE)~VPROT_WRITEWATCH) return idx;
+        idx++;
+    }
+    while (last - idx >= sizeof(word))
+    {
+        memcpy( &word, protection + idx, sizeof(word) );
+        if ((word & mask) != expected) break;
+        idx += sizeof(word);
+    }
+    while (idx < last && !((protection[idx] ^ vprot) & (BYTE)~VPROT_WRITEWATCH)) idx++;
+    return idx;
+}
+
+static unsigned int w3c_lookup_memory( const void *addr, MEMORY_BASIC_INFORMATION *info )
+{
+    const struct w3c_query_view *entries;
+    const BYTE *protection;
+    unsigned long long base = (ULONG_PTR)ROUND_ADDR( addr, page_mask );
+    unsigned int attempt;
+    for (attempt = 0; attempt < 3; attempt++)
+    {
+        unsigned long long seq, topology, limit, end;
+        unsigned int i, count, lo, hi;
+        struct w3c_query_view view;
+        BYTE vprot;
+        SIZE_T idx, last;
+        seq = __atomic_load_n( &w3c_import->sequence, __ATOMIC_ACQUIRE );
+        if (seq & 1) continue;
+        if (!w3c_import->valid || w3c_import->magic != W3C_SHARED_QUERY_MAGIC ||
+            w3c_import->version != W3C_QUERY_VERSION) return STATUS_NOT_SUPPORTED;
+        limit = w3c_import->limit;
+        if (base >= limit || base >= W3C_QUERY_ADDRESS_LIMIT) return STATUS_NOT_SUPPORTED;
+        topology = w3c_import->topology;
+        if (topology != w3c_index_topology)
+        {
+            count = w3c_import->used;
+            if (count > W3C_QUERY_SLOTS) return STATUS_NOT_SUPPORTED;
+            entries = (const void *)((const char *)w3c_import + W3C_QUERY_VIEWS_OFFSET);
+            w3c_index_count = 0;
+            w3c_index_topology = 0; /* failed copies must never poison the cache */
+            for (i = 0; i < count; i++)
+            {
+                view = entries[i];
+                if (view.size) w3c_index[w3c_index_count++] = view;
+            }
+            if (!w3c_read_stable( seq )) continue;
+            qsort( w3c_index, w3c_index_count, sizeof(*w3c_index), w3c_compare_views );
+            w3c_index_topology = topology;
+            continue; /* acquire a fresh generation after sorting */
+        }
+        lo = 0;
+        hi = w3c_index_count;
+        while (lo < hi)
+        {
+            unsigned int mid = lo + (hi - lo) / 2;
+            if (w3c_index[mid].base <= base) lo = mid + 1;
+            else hi = mid;
+        }
+        memset( info, 0, sizeof(*info) );
+        info->BaseAddress = (void *)(ULONG_PTR)base;
+        if (!lo || base - w3c_index[lo - 1].base >= w3c_index[lo - 1].size)
+        {
+            end = lo < w3c_index_count ? w3c_index[lo].base : limit;
+            if (end <= base) return STATUS_NOT_SUPPORTED;
+            info->RegionSize = end - base;
+            info->State = MEM_FREE;
+            info->Protect = PAGE_NOACCESS;
+        }
+        else
+        {
+            view = w3c_index[lo - 1];
+            /* SEC_RESERVE is valid here; mirror normal fill_basic_memory_info semantics. */
+            end = view.base + view.size;
+            if (end < view.base || end > W3C_QUERY_ADDRESS_LIMIT || (end & page_mask))
+                return STATUS_NOT_SUPPORTED;
+            protection = (const BYTE *)w3c_import + W3C_QUERY_META_SIZE;
+            idx = base >> page_shift;
+            last = end >> page_shift;
+            vprot = protection[idx];
+            idx = w3c_protection_end( protection, idx, last, vprot );
+            info->AllocationBase = (void *)(ULONG_PTR)view.base;
+            info->RegionSize = (idx << page_shift) - base;
+            info->State = (vprot & VPROT_COMMITTED) ? MEM_COMMIT : MEM_RESERVE;
+            info->Protect = (vprot & VPROT_COMMITTED) ? get_win32_prot( vprot, view.protect ) : 0;
+            info->AllocationProtect = get_win32_prot( view.protect, view.protect );
+            if (view.protect & SEC_IMAGE) info->Type = MEM_IMAGE;
+            else if (view.protect & (SEC_FILE | SEC_RESERVE | SEC_COMMIT)) info->Type = MEM_MAPPED;
+            else info->Type = MEM_PRIVATE;
+        }
+        if (w3c_read_stable( seq )) return STATUS_SUCCESS;
+    }
+    return STATUS_NOT_SUPPORTED;
+}
+#endif
+static unsigned int w3c_shared_memory_info( HANDLE process, const void *addr,
+                                           MEMORY_BASIC_INFORMATION *info, BOOL *initialize )
+{
+#ifdef W3C_QUERY_SUPPORTED
+    unsigned long long id = 0;
+    unsigned int status;
+    int fd;
+    const void *mapping;
+    sigset_t sigset;
+    if (!is_win64 || is_wow64()) return STATUS_NOT_SUPPORTED;
+    server_enter_uninterrupted_section( &w3c_reader_mutex, &sigset );
+    if (w3c_import && process == w3c_import_process && ++w3c_server_check_count < 256)
+    {
+        status = w3c_lookup_memory( addr, info );
+        if (!status) goto done;
+    }
+    w3c_server_check_count = 0;
+    status = server_get_w3c_query( process, w3c_import_id, &id, &fd, initialize );
+    if (status || *initialize) goto done;
+    if (fd != -1)
+    {
+        mapping = mmap( NULL, W3C_QUERY_FILE_SIZE, PROT_READ, MAP_SHARED, fd, 0 );
+        close( fd );
+        if (mapping == MAP_FAILED) { status = STATUS_NOT_SUPPORTED; goto done; }
+        if (w3c_import) munmap( (void *)w3c_import, W3C_QUERY_FILE_SIZE );
+        w3c_import = mapping;
+        w3c_import_id = id;
+        w3c_index_topology = 0;
+    }
+    if (!w3c_import || id != w3c_import_id) { status = STATUS_NOT_SUPPORTED; goto done; }
+    w3c_import_process = process;
+    if (!w3c_index)
+    {
+        w3c_index = anon_mmap_alloc( W3C_QUERY_SLOTS * sizeof(*w3c_index), PROT_READ | PROT_WRITE );
+        if (w3c_index == MAP_FAILED)
+        {
+            w3c_index = NULL;
+            status = STATUS_NOT_SUPPORTED;
+            goto done;
+        }
+    }
+    status = w3c_lookup_memory( addr, info );
+done:
+    server_leave_uninterrupted_section( &w3c_reader_mutex, &sigset );
+    return *initialize ? STATUS_NOT_SUPPORTED : status;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
