@@ -0,0 +1,31 @@
+/* W3C SharedQuery experiment. LGPL-2.1-or-later, same as Wine.
+ * Fixed-width Linux/x86-64 layout. No pointers, no Windows APC ABI changes.
+ */
+#ifndef __WINE_W3C_SHARED_QUERY_H
+#define __WINE_W3C_SHARED_QUERY_H
+#define W3C_SHARED_QUERY_MAGIC 0x57335351u
+#define W3C_QUERY_VERSION 1u
+#define W3C_QUERY_SLOTS 65536u
+#define W3C_QUERY_VIEWS_OFFSET 4096ULL
+#define W3C_QUERY_META_SIZE (W3C_QUERY_VIEWS_OFFSET + W3C_QUERY_SLOTS * 24ULL)
+#define W3C_QUERY_ADDRESS_LIMIT (1ULL << 47)
+#define W3C_QUERY_PAGE_BYTES (W3C_QUERY_ADDRESS_LIMIT >> 12)
+#define W3C_QUERY_FILE_SIZE (W3C_QUERY_META_SIZE + W3C_QUERY_PAGE_BYTES)
+/* Linux constants, kept private to avoid libc/linux fcntl header conflicts. */
+#define W3C_F_ADD_SEALS 1033
+#define W3C_F_GET_SEALS 1034
+#define W3C_SIZE_SEALS 6 /* F_SEAL_SHRINK | F_SEAL_GROW */
+struct w3c_query_header
+{
+    unsigned long long sequence;
+    unsigned long long topology;
+    unsigned long long limit;
+    unsigned int magic, version, valid, used;
+};
+struct w3c_query_view
+{
+    unsigned long long base, size;
+    unsigned int protect, reserved;
+};
+C_ASSERT( sizeof(struct w3c_query_view) == 24 );
+#endif
