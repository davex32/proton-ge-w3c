 }
+
+/* Deliberately narrow: inherited environment in WebView/Battle.net is insufficient. */
+static int w3c_image_name( const struct process *process, const char *name )
+{
+    unsigned int i, start = 0, len = process->imagelen / sizeof(WCHAR);
+    if (!process->image) return 0;
+    for (i = 0; i < len; i++)
+        if (process->image[i] == '\\' || process->image[i] == '/') start = i + 1;
+    if (len - start != strlen( name )) return 0;
+    for (i = start; i < len; i++)
+    {
+        unsigned int c = process->image[i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != (unsigned char)name[i - start]) return 0;
+    }
+    return 1;
+}
+
+int w3c_query_allowed( struct process *caller, struct process *target )
+{
+    return caller != target && caller->machine == IMAGE_FILE_MACHINE_AMD64 &&
+           target->machine == IMAGE_FILE_MACHINE_AMD64 &&
+           w3c_image_name( caller, "w3champions.exe" ) &&
+           w3c_image_name( target, "warcraft iii.exe" );
+}
+
+DECL_HANDLER(w3c_register_query)
+{
+    static unsigned __int64 next_id;
+    struct process *process = current->process;
+    struct stat st;
+    int fd = thread_get_inflight_fd( current, req->fd );
+    int seals;
+    if (fd == -1) { set_error( STATUS_INVALID_PARAMETER ); return; }
+#ifdef __linux__
+    if (process->machine == IMAGE_FILE_MACHINE_AMD64 &&
+        w3c_image_name( process, "warcraft iii.exe" ) &&
+        process->w3c_query_attempted && process->w3c_query_fd == -1 &&
+        !fstat( fd, &st ) && st.st_size == W3C_QUERY_FILE_SIZE &&
+        (fcntl( fd, F_GETFL ) & O_ACCMODE) == O_RDONLY &&
+        (seals = fcntl( fd, W3C_F_GET_SEALS )) >= 0 &&
+        (seals & W3C_SIZE_SEALS) == W3C_SIZE_SEALS)
+    {
+        process->w3c_query_fd = fd;
+        process->w3c_query_id = ++next_id;
+        return;
+    }
+#endif
+    close( fd );
+    set_error( STATUS_NOT_SUPPORTED );
+}
+
+DECL_HANDLER(w3c_get_query)
+{
+    struct process *process;
+    if (!(process = get_process_from_handle( req->handle, PROCESS_QUERY_LIMITED_INFORMATION ))) return;
+    if (!w3c_query_allowed( current->process, process ) || !process->running_threads || process->is_terminating)
+        set_error( STATUS_NOT_SUPPORTED );
+    else if (process->w3c_query_fd == -1)
+    {
+        if (!process->w3c_query_attempted)
+        {
+            process->w3c_query_attempted = 1;
+            reply->initialize = 1;
+        }
+        else set_error( STATUS_NOT_SUPPORTED );
+    }
+    else
+    {
+        reply->id = process->w3c_query_id;
+        if (req->cached_id != process->w3c_query_id)
+        {
+            if (send_client_fd( current->process, process->w3c_query_fd, req->handle ))
+                set_error( STATUS_TOO_MANY_OPENED_FILES );
+            else reply->send_fd = 1;
+        }
+    }
+    release_object( process );
+}

