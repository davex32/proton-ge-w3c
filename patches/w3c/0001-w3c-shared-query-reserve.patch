diff --git a/dlls/ntdll/unix/w3c_query_publisher.h b/dlls/ntdll/unix/w3c_query_publisher.h
new file mode 100644
index 00000000000..62a5b423f1b
--- /dev/null
+++ b/dlls/ntdll/unix/w3c_query_publisher.h
@@ -0,0 +1,159 @@
+/* Included by virtual.c. LGPL-2.1-or-later.
+ * Mirror Wine allocation metadata and one protection byte per guest page.
+ * Publishing is serialized by virtual_mutex; readers never take that mutex.
+ */
+#if defined(__linux__) && defined(__x86_64__) && defined(_WIN64) && defined(__NR_memfd_create)
+#define W3C_QUERY_SUPPORTED 1
+static struct w3c_query_header *w3c_export;
+static unsigned int w3c_lock_depth;
+static unsigned int w3c_free_slots[W3C_QUERY_SLOTS], w3c_free_count;
+static unsigned char w3c_mirror_blocks[W3C_QUERY_PAGE_BYTES >> 20];
+static unsigned int w3c_mirror_block_count;
+static BOOL w3c_init_attempted;
+
+static void w3c_write_begin(void)
+{
+    if (!w3c_lock_depth++ && w3c_export)
+        __atomic_add_fetch( &w3c_export->sequence, 1, __ATOMIC_SEQ_CST );
+}
+static void w3c_write_end(void)
+{
+    assert( w3c_lock_depth );
+    if (!--w3c_lock_depth && w3c_export)
+    {
+        w3c_export->limit = (ULONG_PTR)working_set_limit;
+        __atomic_add_fetch( &w3c_export->sequence, 1, __ATOMIC_SEQ_CST );
+    }
+}
+static void w3c_update_view( struct file_view *view )
+{
+    struct w3c_query_view *entries;
+    if (!w3c_export || !w3c_export->valid || !view->w3c_slot) return;
+    entries = (void *)((char *)w3c_export + W3C_QUERY_VIEWS_OFFSET);
+    entries[view->w3c_slot - 1].base = (ULONG_PTR)view->base;
+    entries[view->w3c_slot - 1].size = view->size;
+    entries[view->w3c_slot - 1].protect = view->protect;
+    w3c_export->topology++;
+}
+static void w3c_publish_view( struct file_view *view )
+{
+    if (!w3c_export || !w3c_export->valid) return;
+    if (!view->w3c_slot)
+    {
+        if (w3c_free_count) view->w3c_slot = w3c_free_slots[--w3c_free_count];
+        else if (w3c_export->used < W3C_QUERY_SLOTS) view->w3c_slot = ++w3c_export->used;
+        else { w3c_export->valid = 0; return; } /* never publish a truncated map */
+    }
+    w3c_update_view( view );
+}
+static void w3c_unpublish_view( struct file_view *view )
+{
+    struct w3c_query_view *entries;
+    if (!w3c_export || !w3c_export->valid || !view->w3c_slot) return;
+    entries = (void *)((char *)w3c_export + W3C_QUERY_VIEWS_OFFSET);
+    entries[view->w3c_slot - 1].size = 0;
+    w3c_free_slots[w3c_free_count++] = view->w3c_slot;
+    view->w3c_slot = 0;
+    w3c_export->topology++;
+}
+static void w3c_mirror_vprot( const void *addr, size_t size )
+{
+    size_t idx = (ULONG_PTR)addr >> page_shift;
+    size_t end = ((ULONG_PTR)addr + size + page_mask) >> page_shift;
+    BYTE *dest;
+    if (!w3c_export || !w3c_export->valid || idx >= W3C_QUERY_PAGE_BYTES) return;
+    end = min( end, W3C_QUERY_PAGE_BYTES );
+    dest = (BYTE *)w3c_export + W3C_QUERY_META_SIZE;
+    while (idx < end)
+    {
+        size_t block = idx >> pages_vprot_shift, offset = idx & pages_vprot_mask;
+        size_t count = min( end - idx, pages_vprot_mask + 1 - offset );
+        if (!w3c_mirror_blocks[block])
+        {
+            /* Bound metadata memory even with highly scattered mappings. */
+            if (w3c_mirror_block_count == 128) { w3c_export->valid = 0; return; }
+            w3c_mirror_blocks[block] = 1;
+            w3c_mirror_block_count++;
+        }
+        if (block >= pages_vprot_size || !pages_vprot[block]) { w3c_export->valid = 0; return; }
+        memcpy( dest + idx, pages_vprot[block] + offset, count );
+        idx += count;
+    }
+}
+#else
+static void w3c_write_begin(void) {}
+static void w3c_write_end(void) {}
+static void w3c_update_view( struct file_view *view ) {}
+static void w3c_publish_view( struct file_view *view ) {}
+static void w3c_unpublish_view( struct file_view *view ) {}
+static void w3c_mirror_vprot( const void *addr, size_t size ) {}
+#endif
+static void w3c_virtual_enter( sigset_t *sigset )
+{
+    server_enter_uninterrupted_section( &virtual_mutex, sigset );
+    w3c_write_begin();
+}
+static void w3c_virtual_leave( sigset_t *sigset )
+{
+    w3c_write_end();
+    server_leave_uninterrupted_section( &virtual_mutex, sigset );
+}
+static void w3c_virtual_signal_enter(void)
+{
+    mutex_lock( &virtual_mutex );
+    w3c_write_begin();
+}
+static void w3c_virtual_signal_leave(void)
+{
+    w3c_write_end();
+    mutex_unlock( &virtual_mutex );
+}
+void virtual_w3c_query_init(void)
+{
+#ifdef W3C_QUERY_SUPPORTED
+    struct file_view *view;
+    struct w3c_query_header *mapping;
+    char path[64];
+    sigset_t sigset;
+    int fd = -1, readonly_fd = -1;
+    unsigned int status;
+    w3c_virtual_enter( &sigset );
+    if (w3c_init_attempted) goto done;
+    w3c_init_attempted = TRUE;
+    if (!is_win64 || is_wow64() || host_page_size != 4096) goto done;
+    /* MFD_CLOEXEC | MFD_ALLOW_SEALING. No files in the prefix or /tmp. */
+    fd = syscall( __NR_memfd_create, "wine-w3c-query", 3 );
+    if (fd == -1 || ftruncate( fd, W3C_QUERY_FILE_SIZE ) ||
+        fcntl( fd, W3C_F_ADD_SEALS, W3C_SIZE_SEALS )) goto done;
+    mapping = mmap( NULL, W3C_QUERY_FILE_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+    if (mapping == MAP_FAILED) goto done;
+    mapping->sequence = 1; /* initialized while the outer lock is already held */
+    mapping->magic = W3C_SHARED_QUERY_MAGIC;
+    mapping->version = W3C_QUERY_VERSION;
+    mapping->limit = (ULONG_PTR)working_set_limit;
+    mapping->valid = 1;
+    w3c_export = mapping;
+    WINE_RB_FOR_EACH_ENTRY( view, &views_tree, struct file_view, entry )
+    {
+        w3c_publish_view( view );
+        w3c_mirror_vprot( view->base, view->size );
+        if (!w3c_export->valid) break;
+    }
+    if (!w3c_export->valid) goto done;
+    snprintf( path, sizeof(path), "/proc/self/fd/%d", fd );
+    readonly_fd = open( path, O_RDONLY | O_CLOEXEC );
+    if (readonly_fd == -1) { w3c_export->valid = 0; goto done; }
+    wine_server_send_fd( readonly_fd );
+    SERVER_START_REQ( w3c_register_query )
+    {
+        req->fd = readonly_fd;
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    if (status) w3c_export->valid = 0;
+done:
+    if (readonly_fd != -1) close( readonly_fd );
+    if (fd != -1) close( fd );
+    w3c_virtual_leave( &sigset );
+#endif
+}
