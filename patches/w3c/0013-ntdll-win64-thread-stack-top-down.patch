+     * land above 4GB. Allocate them the same way instead of filling from the
+     * bottom of the address space. */
+    status = map_view( &view, NULL, size, is_win64 ? MEM_TOP_DOWN : 0,
+                       VPROT_READ | VPROT_WRITE | VPROT_COMMITTED,
                        limit_low, limit_high, 0 );
     if (status != STATUS_SUCCESS) goto done;
 
